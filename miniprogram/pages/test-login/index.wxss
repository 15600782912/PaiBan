button.account-card { display:block; width:100%; padding:24rpx 28rpx; margin:0 0 16rpx; border:1rpx solid #e1e9e4; border-radius:20rpx; background:#fff; color:#192b24; text-align:left; line-height:1.6; }
.account-name { font-size:29rpx; font-weight:600; overflow-wrap:anywhere; }
.account-description { color:#78857e; font-size:24rpx; font-weight:400; margin-top:8rpx; overflow-wrap:anywhere; }
