.page { min-height:100vh; }
.company-filter-row { position:relative; display:flex; align-items:center; margin-top:24rpx; }
button.company-filter-pill { display:inline-flex; align-items:center; gap:12rpx; flex:0 1 auto; width:auto; min-width:0; max-width:70%; height:64rpx; padding:0 24rpx; margin:0; border-radius:999rpx; background:#e8eee9; color:#2c5341; font-size:26rpx; line-height:64rpx; }
.company-filter-name { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.company-filter-arrow { flex-shrink:0; color:#78857e; font-size:24rpx; }
.company-menu { position:absolute; top:calc(100% + 12rpx); left:0; z-index:30; width:520rpx; min-width:70%; max-width:100%; padding:8rpx; border:1rpx solid #dfe7e2; border-radius:20rpx; background:#fff; box-shadow:0 12rpx 36rpx rgba(14,31,23,.12); }
.company-menu-options { display:block; max-height:360rpx; box-sizing:border-box; }
button.company-menu-option { display:flex; align-items:center; justify-content:space-between; gap:20rpx; width:100%; min-height:88rpx; padding:22rpx 20rpx; margin:0; border-radius:12rpx; background:#fff; color:#192b24; text-align:left; font-size:28rpx; line-height:1.6; }
button.company-menu-option.is-selected { background:#edf6f0; color:#12664f; }
.company-menu-option-name { flex:1; min-width:0; white-space:normal; overflow-wrap:anywhere; word-break:break-all; }
.company-menu-check { flex-shrink:0; color:#12664f; font-size:32rpx; font-weight:600; }

.schedule-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:24rpx 0; }
.room-group { margin:24rpx 0; background:#fff; border:1rpx solid #e8eeea; border-radius:24rpx; padding:24rpx; }
.room-title { flex:1; min-width:0; font-size:30rpx; font-weight:600; overflow-wrap:anywhere; }
.room-record { border-top:1rpx solid #edf0ed; margin-top:20rpx; padding-top:20rpx; }
.room-record-time { font-size:32rpx; font-weight:600; margin:12rpx 0 6rpx; }
.room-empty { color:#78857e; padding:24rpx 0 8rpx; font-size:24rpx; }
.room-group button.text, .schedule-heading button.text { width:auto; flex:0 0 auto; }

.schedule-filters { gap:12rpx; }
.schedule-filters button.company-filter-pill { max-width:48%; }
.room-filter-menu { left:auto; right:0; }

button.cancelled-toggle { display:inline-flex; align-items:center; width:auto; margin:16rpx 0; }

.company-menu { box-sizing:border-box; }
.member-filters { z-index:32; }
.schedule-filters:not(.member-filters) { z-index:34; }
.schedule-filters:not(.member-filters) button.company-filter-pill { max-width:100%; }
.view-modes { display:flex; gap:8rpx; background:#e8eee9; border-radius:18rpx; padding:6rpx; margin:24rpx 0 16rpx; width:240rpx; }
.view-modes button { flex:1; min-width:0; margin:0; padding:0; line-height:64rpx; font-size:26rpx; background:transparent; color:#596e63; }
.view-modes button.selected { background:#fff; color:#12664f; }
.schedule-day-label { color:#12664f; font-weight:600; margin-bottom:16rpx; }
