<view class="page">
  <view class="header"><view class="eyebrow">TEAM SETTINGS</view><view class="title">公司管理</view><view class="subtitle">管理团队成员与排班权限。</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="muted">正在加载…</view>
  <block wx:if="{{company}}">
    <view class="card"><view class="label">公司名称</view><input wx:if="{{owner}}" value="{{name}}" bindinput="input" maxlength="80" disabled="{{busy}}"/><view wx:else class="section">{{company.name}}</view><button wx:if="{{owner}}" class="secondary small" bindtap="rename" disabled="{{busy}}" style="margin-top:20rpx">保存名称</button></view>
    <view wx:if="{{owner}}" class="card">
      <view class="label">公司邀请码</view><view class="section" style="letter-spacing:3rpx">{{company.invite_code}}</view><view class="muted">分享给主播，对方登录后即可加入公司。请妥善分享。</view>
      <view class="actions"><button class="secondary small" bindtap="copyCode">复制邀请码</button><button class="secondary small" bindtap="resetCode" disabled="{{busy}}">重置邀请码</button></view>
    </view>
    <view class="row section"><text>团队成员</text><text class="muted">{{members.length}} 人</text></view>
    <view wx:for="{{members}}" wx:key="user_id" class="card"><view class="row"><text class="record-time">{{item.display_name}}</text><text class="badge">{{item.roleName}}</text></view>
      <view wx:if="{{owner && item.role !== 'owner'}}" class="actions"><button class="secondary small" bindtap="role" data-id="{{item.user_id}}" disabled="{{busy}}">{{item.role === 'operator' ? '取消排班授权' : '授权排班'}}</button><button class="danger small" bindtap="remove" data-id="{{item.user_id}}" disabled="{{busy}}">移除成员</button></view>
    </view>
    <button wx:if="{{!owner}}" class="danger" bindtap="leave" disabled="{{busy}}">退出公司</button>
    <view wx:else class="muted">公司创建者不可退出公司。</view>
  </block>
  <button wx:if="{{!loading && !company}}" class="secondary" bindtap="load">重新加载</button>
</view>
