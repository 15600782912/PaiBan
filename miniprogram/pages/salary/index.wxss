.salary-card { padding:28rpx; }
.salary-name { font-size:31rpx; font-weight:650; overflow-wrap:anywhere; }
.salary-price { font-size:40rpx; color:#159268; font-weight:650; margin-top:20rpx; }
.salary-price text { font-size:23rpx; color:#85928a; font-weight:400; }
.salary-actions { display:flex; justify-content:flex-end; gap:22rpx; margin-top:16rpx; }
.salary-tip { text-align:center; margin-top:24rpx; }
.salary-mask { position:fixed; inset:0; background:rgba(14,28,22,.46); z-index:100; display:flex; align-items:flex-end; }
.salary-editor { width:100%; max-height:88vh; overflow-y:auto; background:white; border-radius:28rpx 28rpx 0 0; padding:32rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); }
