:host { display:block; }
.dropdown { font-size:26rpx; color:#192b24; }
button.trigger { width:100%; margin:0; padding:22rpx 24rpx; background:#f1f5f3; border:1rpx solid #dfe7e2; border-radius:14rpx; display:flex; gap:16rpx; align-items:center; justify-content:space-between; text-align:left; font-size:26rpx; line-height:1.6; box-sizing:border-box; }
button.trigger::after { border:0; }
.label { flex:1; overflow-wrap:anywhere; }
.arrow { flex-shrink:0; color:#667e72; }
.disabled { opacity:.55; }
.options { max-height:360rpx; box-sizing:border-box; border:1rpx solid #dfe7e2; border-radius:14rpx; margin-top:8rpx; background:#fff; }
.option { padding:22rpx 24rpx; min-height:80rpx; border-bottom:1rpx solid #edf2ef; display:flex; align-items:center; justify-content:space-between; gap:12rpx; box-sizing:border-box; line-height:1.6; overflow-wrap:anywhere; }
.option:last-child { border-bottom:0; }
.selected { background:#e7f5ee; color:#147759; }
.check { flex-shrink:0; }
.empty { padding:24rpx; color:#85968d; }
